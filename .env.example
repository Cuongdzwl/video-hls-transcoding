# SSH Server Configuration
SSH_HOST=example.com
SSH_PORT=22
SSH_USER=username
SSH_KEY_PATH=~/.ssh/id_rsa

# Server Paths
SERVER_BASE_PATH=/var/www/videos
SERVER_BACKUP_PATH=/var/www/videos_backup

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_PREFIX=
R2_PUBLIC_BASE_URL=

# Local paths (edited/output/log) are no longer configured here.
# Set them per-run via manifest.json (edited_path/output_path/log_path fields)
# or fall back to the ./edited, ./output, ./log defaults.

# Options
AUTO_BACKUP=true
BACKUP_TIMESTAMP_FORMAT=%Y%m%d_%H%M%S
